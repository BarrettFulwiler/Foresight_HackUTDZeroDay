# Copy to .env.local and fill in. Never commit .env.local or prefix these with NEXT_PUBLIC_.
NESSIE_KEY=
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# Nessie account IDs for the demo customer (they belong to one key; share the team key privately)
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ID=
NESSIE_SAVINGS_ID=
NESSIE_CARD_ID=
NESSIE_PNC_CHECKING_ID=
NESSIE_PNC_SAVINGS_ID=
NESSIE_PNC_CARD_ID=
# Google Gemini key from Google AI Studio (server only). Without it, "Explain it with Gemini" shows a setup message.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models to try in order (defaults to gemini-3.5-flash, then two fallbacks)
GEMINI_MODEL=
