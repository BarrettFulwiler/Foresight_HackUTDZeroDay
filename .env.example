# Copy to .env and fill in. Never commit .env. Only the Clerk publishable key may start with NEXT_PUBLIC_.

# Capital One Nessie (server only)
NESSIE_KEY=
NESSIE_URL=https://v2-prod-api.nessieisreal.com
# The personal demo customer. Leave the IDs empty and Foresight finds the customer by this name and each account by
# its nickname (PNC Checking, PNC Savings, PNC Credit card, Capital One Checking, Capital One Savings, Capital One Credit card).
NESSIE_DEMO_CUSTOMER=Alex Rivera
# Optional: pin the IDs instead (they belong to one key; share the team key privately)
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ID=
NESSIE_SAVINGS_ID=
NESSIE_CARD_ID=
NESSIE_PNC_CHECKING_ID=
NESSIE_PNC_SAVINGS_ID=
NESSIE_PNC_CARD_ID=

# Google Gemini key from Google AI Studio (server only). Without it, the Gemini features show a setup message.
GEMINI_API_KEY=
# Optional: comma-separated Gemini models to try in order (defaults to gemini-3.5-flash, then two fallbacks)
GEMINI_MODEL=

# Clerk sign-in (dashboard.clerk.com → API keys). Without both, sign-in is off and the demo still works.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
